# Code and docs are always checked out with LF endings, so the code hashes recorded in run records
# (for example the evaluator's pre-test hash) match the working copy on every OS, including Windows
# with core.autocrlf=true.
* text=auto eol=lf

# Data manifests and run records are hashed byte-for-byte (the snapshot manifest, the freeze record, and
# the manifest guard in scripts/score.py and scripts/evaluate.py). Several were written with CRLF line
# endings on Windows, so store them exactly as written; line-ending conversion would change the hashes.
*.csv -text
*.json -text
*.jsonl -text
